{
  "info": {
    "name": "Secured SRS API Tests",
    "description": "Complete test suite for Secured Student Record System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login with Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save access token for subsequent requests",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    pm.collectionVariables.set('user_id', jsonData.user.id);",
                  "    pm.test('Login successful', function() {",
                  "        pm.expect(jsonData).to.have.property('access');",
                  "        pm.expect(jsonData).to.have.property('refresh');",
                  "        pm.expect(jsonData.user).to.have.property('roles');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should reject invalid credentials', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Account Management",
      "item": [
        {
          "name": "Register New Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123!\",\n  \"confirmPassword\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/register",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "register"]
            }
          }
        },
        {
          "name": "Verify Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PUT_TOKEN_FROM_EMAIL_HERE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/verify_account",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "verify_account"]
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/forgot_pass_token",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "forgot_pass_token"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PUT_TOKEN_FROM_EMAIL_HERE\",\n  \"newPassword\": \"NewPass123!\",\n  \"confirmNewPassword\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/forgot_pass",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "forgot_pass"]
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/accounts/get_my_profile",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "get_my_profile"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"admin123\",\n  \"newPassword\": \"NewAdmin456!\",\n  \"confirmNewPassword\": \"NewAdmin456!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/change_password",
              "host": ["{{base_url}}"],
              "path": ["api", "accounts", "change_password"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Authorization (Roles & Permissions)",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/roles?pageNumber=1&itemsPerPage=10",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "roles"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "itemsPerPage",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Grouped Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/grouped_permissions",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "grouped_permissions"]
            }
          }
        },
        {
          "name": "Create New Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LECTURER\",\n  \"description\": \"University Lecturer Role\",\n  \"permissions\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/create_role",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "create_role"]
            }
          }
        }
      ]
    },
